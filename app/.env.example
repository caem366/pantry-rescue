# Kroger application registration values. Never expose these to the React app.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=http://127.0.0.1:3000/api/shopping/kroger/callback
# Set the location ID selected by the user; required to ground product availability.
KROGER_LOCATION_ID=

# Cloud-browser Demo Market proof. Keep these server-only; never expose them as VITE_* values.
STEEL_API_KEY=
# Enable only in an environment covered by your retailer automation permission.
WALMART_BROWSER_ENABLED=false
# Protected HTTPS Netlify Deploy Preview that serves the existing Demo Market route (#demo-market).
# Quote the value so the #demo-market hash is preserved by Node's env-file parser.
DEMO_MARKET_URL=""

# Public deployment only: exact comma-separated frontend origins allowed to call the API.
# Example: CORS_ORIGINS=https://your-site.netlify.app
CORS_ORIGINS=
# Prevent public demo traffic from creating unlimited billable Steel sessions.
MAX_CLOUD_SESSIONS=3

# TheMealDB recipe discovery. Key "1" is used only as a development fallback.
# Use a supporter key for a publicly shipped application and keep it server-side.
THEMEALDB_API_KEY=
